# ============================================================================
# GOVTECH RAGBOT v3 — BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file:  cp .env.example backend/.env
# Fill in all values marked with YOUR_...
# NEVER commit backend/.env to Git.
# ============================================================================

# ─── SERVER ──────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ─── GOOGLE GEMINI AI ────────────────────────────────────────────────────────
# Get key: https://makersuite.google.com/app/apikey
# SECURITY: Never expose in frontend code. Rotate every 90 days.
GEMINI_API_KEY=AQ.Ab8RN6KHWRt6Rh2ohipRrULk0ABxQrD_ABpx0Aq8aNIh4KgCXQ
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=1500

# ─── QDRANT VECTOR DATABASE ──────────────────────────────────────────────────
# Sign up: https://cloud.qdrant.io/ → create cluster → copy URL + API key
# SECURITY: Grants full read/write. Store in secrets manager in production.
QDRANT_URL=https://7f3d5b11-82b5-44dc-b4e9-4cb8ee38b3b3.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6ZWY4MzIwNzktOTI2YS00YmJkLTlmMTctZWM1NzYwY2I4YmE0In0.6YjtHXAb78QZ6w4qbCQKVz9E3itFQlacANJkc08mkwg
QDRANT_COLLECTION_NAME=kpk_local_govt_act_2013_st
QDRANT_VECTOR_SIZE=384

# ─── EMBEDDINGS ──────────────────────────────────────────────────────────────
# WARNING: Changing model requires full re-indexing of the corpus.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAGBOT_EMBED_DEVICE=cpu
RAGBOT_EMBED_BATCH=64

# ─── RETRIEVAL & RERANKING ───────────────────────────────────────────────────
RAGBOT_MAX_CITATIONS=4
RAGBOT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAGBOT_RERANKER_DEVICE=cpu
RAGBOT_RETRIEVAL_TOP_K=20

# ─── NLP / SPACY ─────────────────────────────────────────────────────────────
# Install: python -m spacy download en_core_web_sm
SPACY_MODEL=en_core_web_sm

# ─── BRAVE SEARCH API (Optional) ─────────────────────────────────────────────
# Sign up: https://brave.com/search/api/  (2,000 free queries/month)
# App works without this — web search feature will be disabled.
BRAVE_API_KEY=YOUR_BRAVE_SEARCH_API_KEY_HERE
BRAVE_SEARCH_RESULT_COUNT=5
BRAVE_SEARCH_LANG=en
BRAVE_SEARCH_COUNTRY=PK

# ─── ADMIN SECURITY ──────────────────────────────────────────────────────────
# Required as X-Admin-Key header for: POST /legal/load-corpus, DELETE /legal/corpus
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# SECURITY: This is your corpus root password. Never share. Rotate quarterly.
ADMIN_SECRET_KEY=YOUR_RANDOM_64_CHAR_HEX_STRING_HERE

# ─── JWT AUTH (Future) ────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# SECURITY: Leaking this key compromises ALL issued tokens.
JWT_SECRET_KEY=YOUR_RANDOM_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MYSQL DATABASE (Future) ──────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=govtech_db
MYSQL_USER=govtech_user
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
MYSQL_POOL_SIZE=5

# ─── DOCUMENT GENERATION ─────────────────────────────────────────────────────
DOCUMENT_OUTPUT_DIR=./generated_docs
DEFAULT_COURT_NAME=Peshawar High Court
DEFAULT_JURISDICTION=Khyber Pakhtunkhwa

# ─── FEATURE FLAGS ───────────────────────────────────────────────────────────
FEATURE_WEB_SEARCH_ENABLED=true
FEATURE_LEGAL_SYSTEM_ENABLED=true
FEATURE_API_DOCS_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_LEGAL_ANALYZE_PER_MINUTE=5
